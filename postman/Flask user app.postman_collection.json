{
  "info": {
    "_postman_id": "35b0ee9b-052f-42e5-bc20-fad735614174",
    "name": "Flask user app",
    "description": "Requests that test the Flask user management REST API (Lab 5 - Postman and APIs).\n\nThe server URL is stored in the environment variable `base_url` (http://localhost:5000). Select the \"Flask user app - local\" environment before sending requests.\n\n| # | Endpoint | Method | Description |\n|---|---|---|---|\n| 1 | {{base_url}}/api/users | GET | Get the list of all users in the database |\n| 2 | {{base_url}}/api/users/<user_id> | GET | Get a single user record that matches the id |\n| 3 | {{base_url}}/api/users/add | POST | Create a new user record |\n| 4 | {{base_url}}/api/users/update | PUT | Update a user record |\n| 5 | {{base_url}}/api/users/delete/<user_id> | DELETE | Delete a user record |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Inserted user is returned with a user_id\", function () {",
              "    const u = pm.response.json();",
              "    pm.expect(u).to.have.property(\"user_id\");",
              "    pm.expect(u.name).to.eql(\"John Doe\");",
              "});",
              "// save the new user id for the other requests",
              "pm.environment.set(\"user_id\", pm.response.json().user_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "add"
          ]
        },
        "description": "Creates a new user record. The user_id is generated automatically by the database and the inserted user is returned.\n\nThe test script saves the returned user_id into the environment variable `user_id`, which the other requests use.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"jondoe@gamil.com\",\n    \"phone\": \"067765434567\",\n    \"address\": \"John Doe Street, Innsbruck\",\n    \"country\": \"Austria\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
